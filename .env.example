PRIMARY_LLM_PROVIDER=openrouter
FALLBACK_LLM_PROVIDER=agy

TELEMETRY_BATCH_SIZE=50
TELEMETRY_FLUSH_INTERVAL=5.0
TELEMETRY_MAX_QUEUE_SIZE=10000