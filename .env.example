GOOGLE_API_KEY=your_google_api_key
OLLAMA_BASE_URL=your_ollama_url
OPENROUTER_BASE_URL=your_openrouter_url
OPENROUTER_API_KEY=your_openrouter_api_key
LLAMA_CPP_BASE_URL=your_llama_cpp_url
